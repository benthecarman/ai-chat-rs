# Required: OpenAI API key
OPENAI_API_KEY=your_api_key_here

# Optional: Base URL for OpenAI API (defaults to https://api.openai.com/v1)
# OPENAI_API_BASE=https://api.openai.com/v1

# Optional: AI model to use (defaults to gpt-4)
# OPENAI_MODEL=gpt-4

# Optional: Word-by-word display settings
# WORD_DISPLAY_DELAY_MS=10    # Set to 0 to disable the word-by-word effect